# Docker Compose-level secrets (docs/15_config_reference.md §9).
# Copy to .env (never committed) and replace every value below before
# running `docker compose up`. docs/15 §10: confirm every credential-
# bearing variable here has been changed from this template before any
# tunnel activation.

POSTGRES_USER=halcheck
POSTGRES_PASSWORD=replace-with-a-real-local-password
POSTGRES_DB=compliancetrail
# Password for the low-privilege app role the backend actually connects as
# (db/init/002_app_role.sh) -- insert+select only on audit_log, never the
# admin credentials above. Must differ from POSTGRES_PASSWORD.
HALCHECK_APP_DB_PASSWORD=replace-with-a-different-real-local-password

MINIO_ROOT_USER=replace-with-local-access-key
MINIO_ROOT_PASSWORD=replace-with-local-secret-key
