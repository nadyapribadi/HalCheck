# Local development (default when this file is absent): the backend on :3001.
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Through a Cloudflare tunnel, the browser is not on this machine, so
# "localhost" would resolve to the *viewer's* computer. Point the frontend at
# the public URL the tunnel exposes, including the /api path, then restart the
# dev server so Vite picks it up:
#
#   VITE_API_BASE_URL=https://halcheck.<your-domain>/api/v1
#
# The matching ingress rule in ~/.cloudflared/<tunnel>.yml routes /api/* to
# port 3001 and everything else to 5173. Remember to allow the public hostname
# too (VITE_ALLOWED_HOSTS) and to add it to the backend's ALLOWED_ORIGIN.
