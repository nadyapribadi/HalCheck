# Fabric connection -- points outside this repo, at the fabric-samples
# checkout from docs/14_developer_setup.md §1.1/1.2. Never commit real
# values (this is why these all live in backend/.env, gitignored).
FABRIC_MSP_ROOT=/private/tmp/fabric-samples-halcheck-p0/test-network/organizations/peerOrganizations/org1.example.com/users
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_TLS_CERT_PATH=/private/tmp/fabric-samples-halcheck-p0/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_CHANNEL_NAME=compliancetrail
FABRIC_BATCH_CHAINCODE_NAME=batch
FABRIC_REFDATA_CHAINCODE_NAME=refdata
# Private half of chaincode/batch/batch.go's compiled-in
# verdictAttestationPublicKeyPEM (docs/04_trd.md §23.2). Generate with:
#   openssl ecparam -name prime256v1 -genkey -noout -out private.pem
# and rebake chaincode's public key + redeploy if this ever changes.
VERDICT_ATTESTATION_KEY_PATH=/replace/with/local/path/private.pem
JWT_SECRET=replace-with-random-local-secret-before-use
JWT_EXPIRY=8h
DATABASE_URL=postgresql://halcheck:replace-with-local-password@localhost:5432/compliancetrail
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-with-local-access-key
MINIO_SECRET_KEY=replace-with-local-secret-key
MINIO_BUCKET=halcheck-compliance-trail-files
ALLOWED_ORIGIN=http://localhost:5173
SDK_TIMEOUT_MS=10000
AI_QUESTION_SOFT_CAP=20
